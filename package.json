{
  "name": "ai-notebook-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "backup": "node scripts/backup-sqlite.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:reference && npm run test:extension",
    "test:reference": "vitest run --exclude extension/**/*.test.js",
    "test:extension": "node --test extension/background.test.js extension/capture.test.js extension/options.test.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^12.11.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
